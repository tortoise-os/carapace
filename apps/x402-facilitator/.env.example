# Sui RPC Endpoint
# Devnet: https://fullnode.devnet.sui.io:443
# Testnet: https://fullnode.testnet.sui.io:443
# Mainnet: https://fullnode.mainnet.sui.io:443
SUI_RPC_URL=https://fullnode.devnet.sui.io:443

# Facilitator private key for gas sponsorship
# Generate with: sui keytool export --key-identity <address>
# Format: suiprivkey1... or base64 encoded
FACILITATOR_PRIVATE_KEY=

# Server port (default: 3402)
PORT=3402

# Supported Sui networks (comma-separated)
SUPPORTED_NETWORKS=sui:devnet,sui:testnet,sui:mainnet

# Max gas per transaction in MIST (1 SUI = 1,000,000,000 MIST)
# Default: 10000000 MIST = 0.01 SUI
MAX_GAS_PER_TX=10000000

# Max payment age in milliseconds (default: 30000 = 30 seconds)
MAX_PAYMENT_AGE_MS=30000
