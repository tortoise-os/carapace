# x402 Facilitator - Environment Variables Template
# Copy this to .env for local development
# For production (fly.io), set these via: fly secrets set KEY=value

# ========================================
# REQUIRED - Server Configuration
# ========================================

# Server port (default: 3606)
PORT=3606

# Environment: development | production | test
NODE_ENV=development

# ========================================
# REQUIRED - Sui Blockchain Configuration
# ========================================

# Sui RPC endpoint
# Development: https://fullnode.devnet.sui.io:443
# Testnet: https://fullnode.testnet.sui.io:443
# Mainnet: https://fullnode.mainnet.sui.io:443
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Facilitator private key (Ed25519) for gas sponsorship
# Generate with: sui keytool generate ed25519
# Format: suiprivkey1... (Bech32 encoded)
# WARNING: Keep this secret! Never commit to git!
FACILITATOR_PRIVATE_KEY=suiprivkey1...

# ========================================
# REQUIRED - Security Configuration
# ========================================

# Allowed CORS origins (comma-separated)
# Examples:
# - Local dev: http://localhost:3000,http://localhost:5173
# - Production: https://yourdomain.com,https://app.yourdomain.com
# - Allow all (NOT recommended for production): *
ALLOWED_ORIGINS=http://localhost:3000

# ========================================
# OPTIONAL - Rate Limiting
# ========================================

# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ========================================
# OPTIONAL - Gas & Payment Configuration
# ========================================

# Maximum gas allowed per transaction (in MIST)
# Default: 10000000 MIST = 0.01 SUI
MAX_GAS_PER_TX=10000000

# Gas budget for transaction execution (in MIST)
# Default: 50000000 MIST = 0.05 SUI
GAS_BUDGET=50000000

# Maximum age of payment signature (milliseconds)
# Default: 30000 = 30 seconds
MAX_PAYMENT_AGE_MS=30000

# ========================================
# OPTIONAL - Monitoring & Alerting
# ========================================

# Minimum wallet balance threshold for alerts (in SUI)
# Default: 1.0 SUI
MIN_WALLET_BALANCE=1.0

# Supported networks (comma-separated)
# Default: sui:devnet,sui:testnet,sui:mainnet
SUPPORTED_NETWORKS=sui:devnet,sui:testnet,sui:mainnet

# ========================================
# OPTIONAL - Observability (Production)
# ========================================

# Logtail source token (for log aggregation)
# Sign up: https://logtail.com/
# LOGTAIL_SOURCE_TOKEN=your-token-here

# Grafana Cloud credentials (for metrics)
# GRAFANA_PROMETHEUS_URL=https://prometheus-prod-10-prod-us-central-0.grafana.net/api/prom/push
# GRAFANA_PROMETHEUS_USER=your-instance-id
# GRAFANA_PROMETHEUS_PASSWORD=your-api-key

# Grafana Loki credentials (for logs)
# GRAFANA_LOKI_URL=https://logs-prod-us-central1.grafana.net/loki/api/v1/push
# GRAFANA_LOKI_USERNAME=your-loki-id
# GRAFANA_LOKI_PASSWORD=your-api-key

# ========================================
# Notes
# ========================================
# 
# For fly.io deployment, set secrets with:
#   fly secrets set FACILITATOR_PRIVATE_KEY="suiprivkey1..."
#   fly secrets set SUI_RPC_URL="https://fullnode.mainnet.sui.io:443"
#   fly secrets set ALLOWED_ORIGINS="https://yourdomain.com"
#
# View all secrets:
#   fly secrets list
#
# Remove a secret:
#   fly secrets unset SECRET_NAME
