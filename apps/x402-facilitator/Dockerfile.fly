# Fly.io optimized Dockerfile for x402 Facilitator
# This Dockerfile is designed to be built from the app directory
# Build command: fly deploy (uses this file automatically if Dockerfile doesn't work)

FROM oven/bun:1.3.1 AS base
WORKDIR /app

# Install dependencies
FROM base AS install

# Copy package files
COPY package.json ./

# For workspace dependencies, we'll install inline
# This avoids the monorepo complexity
RUN bun install --production

# Copy source
FROM base AS build
COPY --from=install /app/node_modules ./node_modules
COPY . .

# Build the application
ENV NODE_ENV=production
RUN bun run build

# Production image
FROM oven/bun:1.3.1-slim AS release
WORKDIR /app

# Copy built application
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules

# Use bun user for security
USER bun

# Expose port
EXPOSE 3606

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD bun run -e "fetch('http://localhost:3606/health').then(r => r.ok ? process.exit(0) : process.exit(1))"

# Start application
CMD ["bun", "run", "dist/index.js"]
