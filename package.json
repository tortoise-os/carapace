{
	"name": "carapace",
	"version": "0.1.0",
	"private": true,
	"description": "TortoiseOS DeFi project on Sui",
	"packageManager": "bun@1.3.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"clean": "git clean -xdf node_modules",
		"clean:workspaces": "turbo clean",
		"dev": "turbo run dev --filter=web",
		"build": "turbo run build",
		"test": "turbo run test:e2e --filter=web",
		"test:unit": "bun test --filter='!**/*.spec.ts'",
		"lint": "turbo lint && bun lint:repo",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint:repo": "bunx sherif@latest",
		"lint:repo:fix": "bunx sherif@latest --fix",
		"typecheck": "turbo typecheck"
	},
	"resolutions": {
		"@mysten/sui": "^1.14.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@playwright/test": "^1.56.1",
		"@t3-oss/env-nextjs": "0.11.1",
		"@types/bun": "^1.1.10",
		"playwright": "^1.56.1",
		"turbo": "^2.6.0",
		"typescript": "^5.6.2"
	},
	"engines": {
		"bun": ">=1.1.0",
		"node": ">=20.0.0"
	}
}
