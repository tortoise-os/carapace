{
  "name": "carapace",
  "version": "0.1.0",
  "private": true,
  "description": "TortoiseOS DeFi project on Sui",
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo run dev --filter=@carapace/web",
    "dev:x402": "turbo run dev --filter=@carapace/x402-facilitator",
    "build": "turbo run build",
    "build:x402": "turbo run build --filter=@carapace/x402-facilitator",
    "test": "turbo run test:e2e --filter=@carapace/web",
    "test:unit": "bun test --filter='!**/*.spec.ts'",
    "test:x402": "cd apps/x402-facilitator && bun test",
    "lint": "turbo lint && bun lint:repo",
    "lint:fix": "turbo lint -- --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:repo": "bunx sherif@latest",
    "lint:repo:fix": "bunx sherif@latest --fix",
    "typecheck": "turbo typecheck"
  },
  "resolutions": {
    "@mysten/sui": "^1.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@playwright/test": "^1.56.1",
    "@t3-oss/env-nextjs": "0.11.1",
    "@types/bun": "^1.3.2",
    "playwright": "^1.56.1",
    "turbo": "^2.6.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  }
}
