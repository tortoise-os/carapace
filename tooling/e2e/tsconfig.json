{
  "extends": "../typescript/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
