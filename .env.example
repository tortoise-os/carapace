# Carapace Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Application
# ============================================
NODE_ENV=development
APP_NAME=Carapace
APP_URL=http://localhost:3501

# ============================================
# Web App (Next.js)
# ============================================
NEXT_PUBLIC_APP_NAME=Carapace
NEXT_PUBLIC_APP_URL=http://localhost:3501
NEXT_PUBLIC_API_URL=http://localhost:3500

# ============================================
# API Server
# ============================================
API_PORT=3500
API_HOST=0.0.0.0

# ============================================
# Sui Network
# ============================================
# Options: localnet, devnet, testnet, mainnet
SUI_NETWORK=localnet
SUI_RPC_URL=http://localhost:9000
SUI_FAUCET_URL=http://localhost:9123

# Deployed contract addresses (update after deployment)
SUI_AMM_PACKAGE_ID=
SUI_VAULT_PACKAGE_ID=

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://carapace:carapace_dev_password@localhost:3502/carapace
DATABASE_HOST=localhost
DATABASE_PORT=3502
DATABASE_NAME=carapace
DATABASE_USER=carapace
DATABASE_PASSWORD=carapace_dev_password

# Connection pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:3503
REDIS_HOST=localhost
REDIS_PORT=3503
REDIS_PASSWORD=

# Cache TTL (seconds)
CACHE_TTL_POOLS=60
CACHE_TTL_VAULTS=60
CACHE_TTL_PRICES=30

# ============================================
# AI/ML Services
# ============================================

# Fee Optimizer
FEE_OPTIMIZER_ENABLED=true
FEE_OPTIMIZER_UPDATE_INTERVAL=3600000  # 1 hour in ms
FEE_OPTIMIZER_MIN_FEE_BPS=20           # 0.20%
FEE_OPTIMIZER_MAX_FEE_BPS=40           # 0.40%

# Vault Optimizer (Nautilus TEE)
VAULT_OPTIMIZER_ENABLED=true
VAULT_OPTIMIZER_UPDATE_INTERVAL=21600000  # 6 hours in ms
NAUTILUS_TEE_URL=
NAUTILUS_TEE_API_KEY=

# Walrus Storage
WALRUS_ENABLED=true
WALRUS_URL=
WALRUS_API_KEY=

# ============================================
# Monitoring & Observability
# ============================================

# Grafana
GRAFANA_URL=http://localhost:3504
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Prometheus
PROMETHEUS_URL=http://localhost:3505

# Logging
LOG_LEVEL=debug  # Options: error, warn, info, debug, trace
LOG_FORMAT=json  # Options: json, pretty

# ============================================
# External APIs
# ============================================

# Price Oracles
PYTH_NETWORK_URL=
SWITCHBOARD_URL=

# Analytics
DUNE_API_KEY=

# ============================================
# Security
# ============================================

# API Keys (generate secure random strings)
API_SECRET_KEY=change_this_to_a_secure_random_string
JWT_SECRET=change_this_to_a_secure_random_string

# CORS
CORS_ORIGIN=http://localhost:3501
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Feature Flags
# ============================================
FEATURE_AMM_ENABLED=true
FEATURE_VAULT_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_AI_OPTIMIZER_ENABLED=true

# ============================================
# Development
# ============================================

# Enable debug features
DEBUG_MODE=true
ENABLE_PLAYGROUND=true
ENABLE_API_DOCS=true

# Seed data
SEED_DATABASE=true

# ============================================
# Testing
# ============================================
TEST_DATABASE_URL=postgresql://carapace:carapace_dev_password@localhost:3502/carapace_test
TEST_TIMEOUT=30000

# E2E Testing
E2E_HEADLESS=true
E2E_BASE_URL=http://localhost:3501

# ============================================
# Production (uncomment for production)
# ============================================
# NODE_ENV=production
# SUI_NETWORK=mainnet
# SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
# DATABASE_SSL=true
# LOG_LEVEL=info
# DEBUG_MODE=false
# ENABLE_PLAYGROUND=false
